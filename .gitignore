# Virtual environment
.venv/
venv/

# Python
__pycache__/
*.pyc
*.pyo

# Secrets — never track ANY .env variant (.env.local, .env.backup, ...)
.env
.env.*

# Runtime output
runs/
*.log
*.log.*

