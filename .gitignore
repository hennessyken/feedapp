.vscode/

# IB Gateway (if inside project)
ibgateway/

# Database files
*.db
*.db-shm
*.db-wal

# Test / coverage artifacts
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Archives / large binaries
*.zip

# OpenAI batch-job results (large .jsonl — bloated git history past 50MB)
batch_jobs/

.gui.pid
.gui.log
