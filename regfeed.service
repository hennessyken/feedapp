[Unit]
Description=Regfeed — Regulatory Signal Aggregator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ken
WorkingDirectory=/home/ken/Regfeed
# .env is loaded by the app itself (config.py → python-dotenv, absolute path),
# exactly as the manual nohup did — so no EnvironmentFile= line is needed, and
# the unit can't be broken by future .env shell-isms (quotes/spaces/export).
ExecStart=/home/ken/Regfeed/.venv/bin/python main.py --continuous
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
