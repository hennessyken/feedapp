[Unit]
Description=Regfeed — nightly API-key membership reconcile
# 03:30 UTC: deliberately BEFORE the site-repo Stripe reconcile crons
# (04:05 / 04:15 UTC) so the two mechanisms never overlap.
Requires=regfeed-reconcile.service

[Timer]
OnCalendar=*-*-* 03:30:00
Persistent=true
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
